{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mols-agent-asset-validator/eval-case.schema.json",
  "title": "Agent Asset Eval Case",
  "type": "object",
  "required": [
    "id",
    "category",
    "input",
    "expected",
    "evidence_requirement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "trigger-positive",
        "trigger-negative",
        "near-miss",
        "behavior",
        "failure",
        "adversarial",
        "orchestration",
        "runtime",
        "instruction-bottleneck",
        "context-noise",
        "stability",
        "human-comprehension"
      ]
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "expected": {
      "type": "object"
    },
    "grader": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "evidence_requirement": {
      "enum": [
        "static",
        "simulation",
        "runtime",
        "human"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
