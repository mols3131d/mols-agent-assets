{
  "version": 11,
  "kind": "deterministic-regression",
  "repository_workspace": {
    "config": "rulesync.jsonc",
    "lock": "rulesync.lock",
    "asset_root": ".rulesync",
    "optional": false
  },
  "library_workspace": {
    "config": "src/rulesync/rulesync.jsonc",
    "asset_root": "src/rulesync/.rulesync",
    "target_neutral": true
  },
  "forbidden_library_generated_surfaces": [
    "src/rulesync/.github",
    "src/rulesync/.agents",
    "src/rulesync/rulesync.lock",
    "src/rulesync/rulesync-npm.lock.json"
  ],
  "verification_dirs": ["tests", "evals", "scenarios", "results"]
}
