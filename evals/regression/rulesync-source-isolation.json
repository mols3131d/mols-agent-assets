{
  "version": 5,
  "kind": "deterministic-regression",
  "canonical": {
    "workspace": "src/rulesync",
    "asset_root": "src/rulesync/.rulesync",
    "config": "src/rulesync/rulesync.jsonc",
    "targets": ["copilot", "antigravity-ide"],
    "features": ["rules", "skills", "subagents"],
    "rules": ["overview.md"],
    "skills": [
      "artifact-consistency-inspector",
      "caveman-ko",
      "clarify-code",
      "guide-technical-docs-repo",
      "load-context-agent-assets",
      "load-context-agent-skills",
      "load-context-coding",
      "load-context-github",
      "load-context-github-mols",
      "load-context-human-writing",
      "load-context-notion",
      "load-context-notion-mols",
      "load-context-tech-doc-fidelity",
      "mols-agent-asset-studio",
      "mols-agent-asset-validator",
      "mols-documents-studio",
      "mols-markdown-dashboard",
      "mols-markdown-for-human",
      "mols-markdown-scripts",
      "mols-mermaid-chart",
      "mols-mermaid-diagram",
      "mols-rule-dry",
      "mols-skill-creator",
      "mols-skill-find",
      "mols-skill-install",
      "news-table",
      "rpwr-loop",
      "searcher",
      "text-humanize-korean",
      "vcs-git-commit",
      "writing"
    ],
    "subagents": [
      "review-adversarial",
      "review-lead",
      "review-quality"
    ]
  },
  "package_surface": {
    "forbid_dot_paths": true,
    "forbid_top_level_dirs": ["tests", "evals", "scenarios", "results"]
  },
  "forbidden_repository_runtime_surfaces": [
    ".rulesync",
    "rulesync.jsonc",
    ".agentsmesh",
    "agentsmesh.yaml",
    ".github/copilot-instructions.md",
    ".github/skills",
    ".github/agents",
    ".agents/rules",
    ".agents/agents"
  ],
  "forbidden_workspace_generated_surfaces": [
    "src/rulesync/.github",
    "src/rulesync/.agents",
    "src/rulesync/rulesync.lock",
    "src/rulesync/rulesync-npm.lock.json"
  ],
  "repository_local_exceptions": [
    ".agents/AGENTS.md",
    ".agents/skills/mols-chatbot-bootstrap"
  ],
  "repository_local_skill_exceptions": [
    "mols-chatbot-bootstrap"
  ],
  "retired": [
    "src/agentsmesh",
    "src/skills",
    "src/skills-chatbot",
    "src/skills-chatbot-runtime",
    "src/agents",
    "src/prompts",
    "src/rules",
    "tests/skills/rulesync-agent-assets",
    "tests/skills/iceberg-code-review",
    "tests/skills/mols-kanban-markdown"
  ]
}
