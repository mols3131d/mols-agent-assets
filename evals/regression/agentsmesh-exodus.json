{
  "version": 1,
  "kind": "deterministic-regression",
  "canonical": {
    "targets": ["copilot", "antigravity"],
    "features": ["rules", "skills", "agents"],
    "rules": ["_root.md"],
    "skills": [
      "artifact-consistency-inspector",
      "caveman-ko",
      "clarify-code",
      "guide-technical-docs-repo",
      "load-context-agent-assets",
      "load-context-agent-skills",
      "load-context-coding",
      "load-context-github",
      "load-context-github-mols",
      "load-context-human-writing",
      "load-context-notion",
      "load-context-notion-mols",
      "load-context-tech-doc-fidelity",
      "mols-agent-asset-studio",
      "mols-agent-asset-validator",
      "mols-documents-studio",
      "mols-markdown-dashboard",
      "mols-markdown-for-human",
      "mols-markdown-scripts",
      "mols-mermaid-chart",
      "mols-mermaid-diagram",
      "mols-rule-dry",
      "mols-skill-creator",
      "mols-skill-find",
      "mols-skill-install",
      "news-table",
      "rpwr-loop",
      "searcher",
      "text-humanize-korean",
      "vcs-git-commit",
      "writing"
    ],
    "agents": [
      "review-adversarial",
      "review-lead",
      "review-quality"
    ]
  },
  "package_surface": {
    "forbid_dot_paths": true,
    "forbid_top_level_dirs": ["tests", "evals", "scenarios", "results"]
  },
  "projections": {
    "copilot": {
      "root_rule": ".github/copilot-instructions.md",
      "skills": ".github/skills",
      "agent_mode": "native",
      "agents": ".github/agents"
    },
    "antigravity": {
      "root_rule": ".agents/rules/general.md",
      "skills": ".agents/skills",
      "agent_mode": "embedded-skill",
      "agent_prefix": "am-agent-"
    }
  },
  "exceptions": [],
  "retired": [
    ".agentsmesh/_legacy",
    ".agentsmesh/rules/language-ko.md",
    "src/skills",
    "src/skills-chatbot",
    "src/skills-chatbot-runtime",
    "src/agents",
    "src/prompts",
    "src/rules",
    "tests/skills/rulesync-agent-assets",
    "tests/skills/iceberg-code-review",
    "tests/skills/mols-kanban-markdown"
  ]
}
