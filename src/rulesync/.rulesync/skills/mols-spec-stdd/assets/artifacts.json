{
  "version": 1,
  "artifacts": {
    "proposal": {
      "kind": "document",
      "default_file": "proposal.md",
      "template": "templates/proposal.md"
    },
    "research": {
      "kind": "document",
      "default_file": "research.md",
      "template": "templates/research.md"
    },
    "plan": {
      "kind": "document",
      "default_file": "plan.md",
      "template": "templates/plan.md"
    },
    "specification": {
      "kind": "document",
      "default_file": "specs/<domain-path>/spec.md",
      "template": "templates/specification-delta.md"
    },
    "test-design": {
      "kind": "document",
      "default_file": "test-design.md",
      "template": "templates/test-design.md"
    },
    "test-implementation": {
      "kind": "code"
    },
    "code-implementation": {
      "kind": "code"
    }
  }
