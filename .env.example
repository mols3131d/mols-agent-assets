# Optional local Promptfoo settings. Select runtime, model, and grader on the CLI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
REQUEST_TIMEOUT_MS=120000
# PROMPTFOO_RUNTIME_TIMEOUT_SECONDS is used when REQUEST_TIMEOUT_MS is unset.
# PROMPTFOO_RUNTIME_THINK=false  # Optional Python Ollama provider setting.
# PROMPTFOO_CODEX_TIMEOUT_MS=120000

# For --codex-auth chatgpt, use an absolute path to a dedicated login-only home.
# PROMPTFOO_CODEX_CHATGPT_HOME=/absolute/path/to/evaluation-codex-home

# For --codex-auth api, inject PROMPTFOO_CODEX_API_KEY at execution time.
# For authenticated Ollama endpoints, inject OLLAMA_API_KEY at execution time.
