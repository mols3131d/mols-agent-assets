# Copy to .env for local Promptfoo evaluation, then edit the values as needed.
# Run through mise. Never commit .env or credentials. See evals/README.md.

# Native runtime: full provider ID, including the model.
PROMPTFOO_RUNTIME_PROVIDER=ollama:chat:qwen3.5:4b
# Grader is independent; it does not follow the runtime.
PROMPTFOO_GRADER_PROVIDER=ollama:chat:qwen3.5:4b

# Per-request timeout for both native and custom paths, in milliseconds.
REQUEST_TIMEOUT_MS=120000

# Custom Ollama model; native fallback only when the full provider ID is unset.
PROMPTFOO_RUNTIME_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Legacy PROMPTFOO_RUNTIME_TIMEOUT_SECONDS is used only if REQUEST_TIMEOUT_MS is unset.

# Runner already disables telemetry, update checks, remote generation and sharing.
# Provider credentials/endpoints use native settings, not project-specific aliases.
# These feature defaults do NOT prevent data transmission to a remote provider.
