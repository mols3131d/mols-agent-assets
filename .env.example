# Copy this file to .env for local Promptfoo/Ollama evaluation.
# .env is machine-specific and ignored by Git. Run evals through mise.

# Model under evaluation and semantic grader (Ollama provider syntax).
PROMPTFOO_RUNTIME_MODEL=qwen2.5
PROMPTFOO_GRADER_PROVIDER=ollama:chat:qwen2.5

# Local Ollama endpoint and per-request timeout in seconds.
OLLAMA_BASE_URL=http://127.0.0.1:11434
PROMPTFOO_RUNTIME_TIMEOUT_SECONDS=120

# Keep Promptfoo's local evaluations from using remote features.
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
PROMPTFOO_DISABLE_SHARING=1
