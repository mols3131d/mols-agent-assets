# Optional overrides for Promptfoo evaluation. Copy to .env; uncomment only changes.
# Run through mise. Never commit .env or credentials. See evals/README.md.

# Native runtime: full provider ID. Default: ollama:chat:qwen2.5.
# PROMPTFOO_RUNTIME_PROVIDER=openai:chat:gpt-4o-mini
# PROMPTFOO_RUNTIME_PROVIDER=anthropic:messages:claude-sonnet-4-5
# Grader is independent; it does not follow the runtime. Default: ollama:chat:qwen2.5.
# PROMPTFOO_GRADER_PROVIDER=openai:chat:gpt-4o-mini

# Preferred per-request timeout for both native and custom paths, in milliseconds.
# REQUEST_TIMEOUT_MS=120000

# Existing custom Ollama path and native fallback when no full ID is set.
# PROMPTFOO_RUNTIME_MODEL=qwen2.5
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Legacy PROMPTFOO_RUNTIME_TIMEOUT_SECONDS is used only if REQUEST_TIMEOUT_MS is unset.

# Runner already disables telemetry, update checks, remote generation and sharing.
# Provider credentials/endpoints use native settings, not project-specific aliases.
# These feature defaults do NOT prevent data transmission to a remote provider.
