# Copy this file to .env for Promptfoo evaluation.
# .env is machine-specific and ignored by Git. Run evals through mise.

# Full native provider ID (optional); takes precedence over the Ollama model.
# PROMPTFOO_RUNTIME_PROVIDER=openai:chat:gpt-4o-mini
# PROMPTFOO_RUNTIME_PROVIDER=anthropic:messages:claude-sonnet-4-5
# Add the selected provider's credentials only to your untracked environment.
# Ollama fallback when no full provider ID is set; also used by custom evals.
PROMPTFOO_RUNTIME_MODEL=qwen2.5
# Independent semantic grader; changing the runtime does not change this default.
PROMPTFOO_GRADER_PROVIDER=ollama:chat:qwen2.5

# Local Ollama endpoint and per-request timeout in seconds.
OLLAMA_BASE_URL=http://127.0.0.1:11434
PROMPTFOO_RUNTIME_TIMEOUT_SECONDS=120

# Disable optional hosted features; remote providers still send eval data.
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
PROMPTFOO_DISABLE_SHARING=1
